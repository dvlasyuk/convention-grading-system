@page "/grading/events/{eventId}/expert-feedback"
@layout BaseLayout

@using ConventionGradingSystem.Host.Components.Grading.Contests.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Layouts
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inherits BasePage<ExpertFeedbackFormModel>

<FeaturePageView Feature="@ApplicationFeature.Contests">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.Form"
                 DefaultPageTitle="Форма отзыва о мероприятии">

<AuthorizeView Roles="@AuthenticationConstants.AdministratorAndExpertRoles">
    <NotAuthorized>
        <UnathorizedView />
    </NotAuthorized>
    <Authorized>

        <PageTitle>Форма отзыва о мероприятии @ViewModel.Event.EventName</PageTitle>

        @if (!ViewModel.Event.IsGraded)
        {
            <MudAlert Severity="@Severity.Warning">
                Мероприятия конкурса <strong>@ViewModel.Event.ContestName</strong> не оцениваются экспертами. Если
                ты вводил адрес страницы в адресную строку браузера вручную или вставлял скопированную ссылку, то
                проверь не ошибся ли ты при вводе или копировании. Если ты переходил по прямой ссылке, то проверь
                корректность этой ссылки или попроси сделать это того, кто её тебе предоставил. Если ты попал сюда
                с другой страницы системы, то это ошибка - обратись, пожалуйста, к разработчикам
            </MudAlert>
            return;
        }

        @if (ViewModel.IsFormDisabled)
        {
            <MudAlert Severity="@Severity.Info">
                Твой отзыв о мероприятии <strong>@ViewModel.Event.EventName</strong> в рамка конкурса мероприятий
                <strong>@ViewModel.Event.ContestName</strong> принят. Спасибо большое за участие!
            </MudAlert>
            return;
        }

        <MudAlert Severity="@Severity.Info">
            Приветствуем тебя, эксперт! Ты можешь свой отзыв о мероприятии <strong>@ViewModel.Event.EventName</strong>
            в рамка конкурса мероприятий <strong>@ViewModel.Event.ContestName</strong>. Оцени мероприятие по приведённым
            критериям, оставь дополнительный комментарий, если хочешь, и нажми кнопку <em>Отправить</em>
        </MudAlert>

        <MudPaper Class="mt-3 pa-3">
            <MudForm @ref="@_formSelector" @bind-IsValid="@ViewModel.IsFormValid">

                <MudAutocomplete T="@ExpertFeedbackFormModel.ExpertModel"
                                 @bind-Value="@ViewModel.Form.SelectedExpert"
                                 SearchFunc="@SearchExpert"
                                 Required="true"
                                 ResetValueOnEmptyText="true"
                                 Label="Выбери себя"
                                 RequiredError="Выбор эксперта обязателен"
                                 Variant="@Variant.Outlined"
                                 Adornment="@Adornment.End"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 Class="my-3" />

                @foreach (var criterion in ViewModel.Event.Criterions)
                {
                    <MudPaper Outlined="true" Class="mt-3 pa-3">
                        <MudText Typo="@Typo.subtitle1">@criterion.Name</MudText>
                        <MudText Typo="@Typo.subtitle2">@criterion.Description</MudText>
                        <MudSlider @bind-Value="@ViewModel.Form.SelectedGrades[criterion.Identifier]"
                                   Min="@criterion.MinimalGrade"
                                   Max="@criterion.MaximalGrade"
                                   TickMarks="true"
                                   TickMarkLabels="@GetSliderLabels(criterion)"
                                   ValueLabel="true"
                                   Variant="@Variant.Outlined"
                                   Class="mt-3 mb-5" />
                    </MudPaper>
                }

                <MudTextField T="@string"
                              @bind-Value="@ViewModel.Form.EnteredNote"
                              Label="Оставь любой дополнительный комментарий"
                              Variant="@Variant.Outlined"
                              Lines="3"
                              Class="my-3" />

                <MudDivider />
                <MudButton OnClick="@ProcessForm"
                           Disabled="@(!ViewModel.IsFormValid)"
                           Variant="@Variant.Outlined"
                           Size="@Size.Large"
                           Color="@Color.Primary"
                           StartIcon="@Icons.Material.Filled.Send"
                           Class="mt-3">
                    Проголосовать
                </MudButton>
            </MudForm>
        </MudPaper>

    </Authorized>
</AuthorizeView>

</ContentPageView>
</FeaturePageView>
