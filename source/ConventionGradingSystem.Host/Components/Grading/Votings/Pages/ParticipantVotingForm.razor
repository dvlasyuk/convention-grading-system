@page "/grading/votings/{votingId}/participant-voting"

@using ConventionGradingSystem.Host.Components.Grading.Votings.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inherits BasePage<ParticipantVotingFormModel>

<FeaturePageView Feature="@ApplicationFeature.Votings">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.Form"
                 DefaultPageTitle="Форма зрительского голосования">

<PageTitle>Форма зрительского голосования @ViewModel.Voting.Name</PageTitle>

@if (ViewModel.IsFormDisabled)
{
    <MudAlert Severity="@Severity.Info">
        Твой голос в голосовании <strong>@ViewModel.Voting.Name</strong> принят. Спасибо большое за участие!
    </MudAlert>
    return;
}

<MudAlert Severity="@Severity.Info">
    Приветствуем тебя! Ты можешь принять участние в голосовании <strong>@ViewModel.Voting.Name</strong>.
    Выбери, пожалуйста, @(ViewModel.Voting.VotesQuantity > 1 ? "кандидатов" : "кандидата"),
    @(ViewModel.Voting.VotesQuantity > 1 ? "которые понравились" : "который понравился") тебе больше остальных,
    оставь дополнительный комментарий, если хочешь, и нажми кнопку <em>Проголосовать</em>
</MudAlert>

<MudPaper Class="mt-3 pa-3">
    <MudForm @ref="@_formSelector" @bind-IsValid="@ViewModel.IsFormValid">
        <MudAutocomplete T="@ParticipantVotingFormModel.TeamModel"
                         @bind-Value="@ViewModel.Form.SelectedTeam"
                         @bind-Value:after="@OnSelectedTeamChange"
                         SearchFunc="@SearchTeam"
                         Required="true"
                         ResetValueOnEmptyText="true"
                         Label="Выбери свою команду"
                         RequiredError="Выбор команды обязателен"
                         Variant="@Variant.Outlined"
                         Adornment="@Adornment.End"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         Class="my-3"/>

        <MudAutocomplete T="@ParticipantVotingFormModel.ParticipantModel"
                         @ref="@_participantSelector"
                         @bind-Value="@ViewModel.Form.SelectedParticipant"
                         @bind-Value:after="@OnSelectedParticipantChange"
                         Disabled="@(ViewModel.Form.SelectedTeam == null)"
                         SearchFunc="@SearchParticipant"
                         Required="true"
                         ResetValueOnEmptyText="true"
                         Label="Выбери себя"
                         RequiredError="Выбор участника обязателен"
                         Variant="@Variant.Outlined"
                         Adornment="@Adornment.End"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         Class="my-3" />

        @for (var number = 0; number < ViewModel.Voting.VotesQuantity; number++)
        {
            var index = number;
            <MudSelect T="@ParticipantVotingFormModel.CandidateModel"
                       @ref="@CandidateSelector"
                       @bind-Value="@ViewModel.Form.SelectedCandidates[index]"
                       @bind-Value:after="@(() => OnSelectedCandidateChange(index))"
                       Disabled="@DisableCandidateSelector(index)"
                       Validation="@(new Func<ParticipantVotingFormModel.CandidateModel, string?>((value) => ValidateSelectedCandidate(index, value)))"
                       Required="true"
                       Label="Выбери понравившегося кандидата"
                       RequiredError="Выбор кандидата обязателен"
                       Variant="@Variant.Outlined"
                       Adornment="@Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.HowToVote"
                       Class="my-3">

                @foreach (var candidate in ViewModel.Voting.Candidates)
                {
                    <MudSelectItem Value="@candidate" />
                }
            </MudSelect>
        }

        <MudTextField T="@string"
                      @bind-Value="@ViewModel.Form.EnteredNote"
                      Label="Оставь любой дополнительный комментарий"
                      Variant="@Variant.Outlined"
                      Lines="3"
                      Class="my-3" />

        <MudDivider />
        <MudButton OnClick="@ProcessForm"
                   Disabled="@(!ViewModel.IsFormValid)"
                   Variant="@Variant.Outlined"
                   Size="@Size.Large"
                   Color="@Color.Primary"
                   StartIcon="@Icons.Material.Filled.Send"
                   Class="mt-3">
            Проголосовать
        </MudButton>
    </MudForm>
</MudPaper>

</ContentPageView>
</FeaturePageView>
