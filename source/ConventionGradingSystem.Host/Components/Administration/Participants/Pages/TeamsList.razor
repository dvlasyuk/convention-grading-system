@page "/administration/teams"

@using ConventionGradingSystem.Host.Components.Administration.Participants.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@attribute [Authorize(Roles = @AuthenticationConstants.AdministratorRole)]
@inherits BasePage<TeamsListModel>

<FeaturePageView Feature="@ApplicationFeature.Teams">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.Table"
                 DefaultPageTitle="Команды участников">

<PageTitle>Команды участников</PageTitle>

<MudTable Items="@ViewModel.Teams"
          Filter="@FilterRecords"
          Breakpoint="@Breakpoint.None"
          Hover="true">

    <ToolBarContent>
        <MudGrid Justify="@Justify.SpaceBetween">
            <MudItem><MudText Typo="@Typo.h6">Команды участников</MudText></MudItem>
            <MudItem xs="5">
                <MudGrid Justify="@Justify.FlexEnd" Spacing="3" Class="align-center">
                    <MudItem>
                        <MudTooltip Text="Экспортировать данные в Excel">
                            <MudIconButton OnClick="ExportDataToExcel" Icon="@Icons.Custom.FileFormats.FileExcel" />
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="10">
                        <MudTextField @bind-Value="@ViewModel.SearchFilter"
                                      MaxLength="50"
                                      Clearable="true"
                                      Placeholder="Поиск"
                                      Adornment="@Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </ToolBarContent>

    <HeaderContent>
        <MudTh />
        <MudTh><MudTableSortLabel T="@TeamsListModel.TeamModel" SortBy="@SelectNameField">Название команды</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@TeamsListModel.TeamModel" SortBy="@SelectMembersField">Количество участников</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@TeamsListModel.TeamModel" SortBy="@SelectRegistrationsField">Количество регистраций</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@TeamsListModel.TeamModel" SortBy="@SelectAttendancesField">Количество посещений</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@TeamsListModel.TeamModel" SortBy="@SelectAbsencesField">Количество пропусков</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@TeamsListModel.TeamModel" SortBy="@SelectSpecialMarksField">Особые отметки</MudTableSortLabel></MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Number</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.MembersQuantity</MudTd>
        <MudTd>@context.RegistrationsQuantity</MudTd>
        <MudTd>@context.AttendancesQuantity</MudTd>
        <MudTd>@context.AbsencesQuantity</MudTd>
        <MudTd>@context.SpecialMarksQuantity</MudTd>
    </RowTemplate>
</MudTable>

</ContentPageView>
</FeaturePageView>
