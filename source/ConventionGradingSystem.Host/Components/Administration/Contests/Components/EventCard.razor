@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="@Typo.h6" Color="@Color.Primary">@Parameters.EventName</MudText>
        <MudText Color="@Color.Primary">@Parameters.ContestName</MudText>
        <MudText>Мероприятие конкурса</MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Outlined="true" Class="mb-3 pa-3">

            <MudGrid Justify="@Justify.SpaceBetween" Class="align-center">
                <MudItem><MudText>Имеются зарегистрированные участники</MudText></MudItem>
                <MudItem>
                    <MudChip T="@string"
                             Text="@(Parameters.ParticipantsRegistered ? "Да" : "Нет")"
                             Color="@(Parameters.ParticipantsRegistered ? Color.Success : @Color.Error)"
                             Variant="@Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudGrid Justify="@Justify.SpaceBetween">
                <MudItem><MudText>Связанные отряды</MudText></MudItem>
                <MudItem>
                    @if (Parameters.Brigades.Count > 0)
                    {
                        <MudStack Spacing="0">
                            @foreach (var brigadeName in Parameters.Brigades)
                            {
                                <MudChip T="@string" Text="@brigadeName" Color="@Color.Primary" Variant="@Variant.Outlined" />
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudChip T="@string" Text="Нет" Color="@Color.Error" Variant="@Variant.Outlined" />
                    }
                </MudItem>
            </MudGrid>

        </MudPaper>
    </DialogContent>
</MudDialog>
