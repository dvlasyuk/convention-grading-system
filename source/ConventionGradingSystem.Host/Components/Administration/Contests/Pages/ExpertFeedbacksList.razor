@page "/administration/events/{eventId}/expert-feedbacks"

@using ConventionGradingSystem.Host.Components.Administration.Contests.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@attribute [Authorize(Roles = @AuthenticationConstants.AdministratorRole)]
@inherits BasePage<ExpertFeedbacksListModel>

<FeaturePageView Feature="@ApplicationFeature.Contests">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.Table"
                 DefaultPageTitle="Отзывы экспертов">

<PageTitle>@ViewModel.Event.EventName - Отзывы экспертов</PageTitle>

@if (!ViewModel.Event.ExpertGrading)
{
    <MudAlert Severity="@Severity.Warning">
        Мероприятия конкурса <strong>@ViewModel.Event.ContestName</strong> не оцениваются экспертами. Если
        ты вводил адрес страницы в адресную строку браузера вручную или вставлял скопированную ссылку, то
        проверь не ошибся ли ты при вводе или копировании. Если ты переходил по прямой ссылке, то проверь
        корректность этой ссылки или попроси сделать это того, кто её тебе предоставил. Если ты попал сюда
        с другой страницы системы, то это ошибка - обратись, пожалуйста, к разработчикам
    </MudAlert>
    return;
}

<MudTable Items="@ViewModel.Feedbacks"
            Filter="@FilterRecords"
            Breakpoint="@Breakpoint.None"
            Hover="true">

    <ToolBarContent>
        <MudGrid Justify="@Justify.SpaceBetween">
            <MudItem>
                <MudGrid Spacing="0" Class="align-center">
                    <MudItem><MudText Typo="@Typo.h6">Отзывы экспертов</MudText></MudItem>
                    <MudItem>
                        <MudIconButton OnClick="@OpenEventCard"
                                       Color="@Color.Primary"
                                       Icon="@Icons.Material.Filled.Info" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="4">
                <MudTextField @bind-Value="@ViewModel.SearchFilter"
                              MaxLength="50"
                              Clearable="true"
                              Placeholder="Поиск"
                              Adornment="@Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
    </ToolBarContent>

    <HeaderContent>
        <MudTh />
        <MudTh><MudTableSortLabel T="@ExpertFeedbacksListModel.FeedbackModel" SortBy="@SelectNameField">Имя эксперта</MudTableSortLabel></MudTh>

        @for (var number = 0; number < ViewModel.Event.GradeCriterions.Count; number++)
        {
            var index = number;
            <MudTh>
                <MudTableSortLabel T="@ExpertFeedbacksListModel.FeedbackModel" SortBy="@(item => SelectGradeField(item, ViewModel.Event.GradeCriterions[index].Identifier))">
                    <MudTooltip Text="@ViewModel.Event.GradeCriterions[index].Name">
                        <div class="d-flex">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Size="@Size.Small" />
                            <MudText Class="ml-1">@(index + 1)</MudText>
                        </div>
                    </MudTooltip>
                </MudTableSortLabel>
            </MudTh>
        }

        <MudTh>Дополнительный комментарий</MudTh>
        <MudTh>Время получения</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Number</MudTd>
        <MudTd>@context.ExpertName</MudTd>

        @for (var number = 0; number < ViewModel.Event.GradeCriterions.Count; number++)
        {
            var index = number;
            <MudTd>@context.Grades[ViewModel.Event.GradeCriterions[index].Identifier]</MudTd>
        }

        <MudTd>@context.Note</MudTd>
        <MudTd>@context.ReceivedAt</MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudAlert Severity="@Severity.Info">
            О мероприятии <strong>@ViewModel.Event.EventName</strong> экспертами не было оставлено ни одного отзыва
        </MudAlert>
    </NoRecordsContent>
</MudTable>

</ContentPageView>
</FeaturePageView>
