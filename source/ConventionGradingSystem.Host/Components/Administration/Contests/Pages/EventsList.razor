@page "/administration/contests/{contestId}/events"

@using ConventionGradingSystem.Host.Components.Administration.Contests.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@attribute [Authorize(Roles = @AuthenticationConstants.AdministratorRole)]
@inherits BasePage<EventsListModel>

<FeaturePageView Feature="@ApplicationFeature.Contests">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.Table"
                 DefaultPageTitle="Мероприятия конкурса">

<PageTitle>@ViewModel.Contest.Name - Мероприятия конкурса</PageTitle>

<MudTable Items="@ViewModel.Events"
          Filter="@FilterRecords"
          Breakpoint="@Breakpoint.None"
          Hover="true"
          HorizontalScrollbar="true">

    <ToolBarContent>
        <MudGrid Justify="@Justify.SpaceBetween">
            <MudItem>
                <MudGrid Spacing="0" Class="align-center">
                    <MudItem><MudText Typo="@Typo.h6">Мероприятия конкурса</MudText></MudItem>
                    <MudItem>
                        <MudIconButton OnClick="@OpenContestCard"
                                       Color="@Color.Primary"
                                       Icon="@Icons.Material.Filled.Info" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="5">
                <MudGrid Justify="@Justify.FlexEnd" Spacing="3" Class="align-center">
                    <MudItem>
                        <MudTooltip Text="Экспортировать данные в Excel">
                            <MudIconButton OnClick="ExportDataToExcel" Icon="@Icons.Custom.FileFormats.FileExcel" />
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="10">
                        <MudTextField @bind-Value="@ViewModel.SearchFilter"
                                      MaxLength="50"
                                      Clearable="true"
                                      Placeholder="Поиск"
                                      Adornment="@Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </ToolBarContent>

    <HeaderContent>

        <MudTh />
        <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectNameField">Название мероприятия</MudTableSortLabel></MudTh>
        <MudTh>Связанные отряды</MudTh>

        @if (ViewModel.Contest.ExpertGrading)
        {
            <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectExpertFeedbacksField">Отзывы экспертов</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectExpertGradeField">Оценка экспертов</MudTableSortLabel></MudTh>
        }
        @if (ViewModel.Contest.ParticipantGrading)
        {
            <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectParticipantFeedbacksField">Отзывы участников</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectParticipantGradeField">Оценка участников</MudTableSortLabel></MudTh>
        }

        <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectTotalGradeField">Общая оценка</MudTableSortLabel></MudTh>
        <MudTh>Действия</MudTh>
    </HeaderContent>

    <RowTemplate>

        <MudTd>@context.Number</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>
            @foreach (var item in @context.Brigades)
            {
                @item
                <br />
            }
        </MudTd>

        @if (ViewModel.Contest.ExpertGrading)
        {
            <MudTd>@context.ExprertFeedbacksQuantity</MudTd>
            <MudTd>@context.ExpertGrade.ToString("0.0")</MudTd>
        }
        @if (ViewModel.Contest.ParticipantGrading)
        {
            <MudTd>@context.ParticipantFeedbacksQuantity</MudTd>
            <MudTd>@context.ParticipantGrade.ToString("0.0")</MudTd>
        }

        <MudTd>@context.TotalGrade.ToString("0.0")</MudTd>
        <MudTd>
            <MudMenu Color="@Color.Primary" Icon="@Icons.Material.Filled.Settings">
                <MudMenuItem OnClick="@(() => OpenEventCard(context))"
                             Icon="@Icons.Material.Filled.Info"
                             Label="Общая информация" />
                @if (ViewModel.Contest.ExpertGrading)
                {
                    <MudMenuItem Href="@NavigationHelper.Administration.ExpertFeedbacksList(context.Identifier)"
                                 Icon="@Icons.Material.Filled.Link"
                                 Label="Отзывы экспертов" />
                }
                @if (ViewModel.Contest.ParticipantGrading)
                {
                    <MudMenuItem Href="@NavigationHelper.Administration.ParticipantFeedbacksList(context.Identifier)"
                                 Icon="@Icons.Material.Filled.Link"
                                 Label="Отзывы участников" />
                }
                <MudDivider />
                @if (ViewModel.Contest.ExpertGrading)
                {
                    <MudMenuItem Href="@NavigationHelper.Grading.ExpertFeedbackForm(context.Identifier)"
                                 Icon="@Icons.Material.Filled.QrCode"
                                 Label="Форма эксперта" />
                }
                @if (ViewModel.Contest.ParticipantGrading)
                {
                    <MudMenuItem Href="@NavigationHelper.Grading.ParticipantFeedbackForm(context.Identifier)"
                                 Icon="@Icons.Material.Filled.QrCode"
                                 Label="Форма участника" />
                }
                @if (ViewModel.Contest.AttendanceControl)
                {
                    <MudMenuItem Href="@NavigationHelper.Grading.FacilitatorAttendanceForm(context.Identifier)"
                                 Icon="@Icons.Material.Filled.QrCode"
                                 Label="Форма посещаемости" />
                }
            </MudMenu>
        </MudTd>

    </RowTemplate>
</MudTable>

</ContentPageView>
</FeaturePageView>
