@page "/administration/contests/{contestId}/events"

@using ConventionGradingSystem.Host.Components.Administration.Contests.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@attribute [Authorize(Roles = @AuthenticationConstants.AdministratorRole)]
@inherits BasePage<EventsListModel>

<FeaturePageView Feature="@ApplicationFeature.Contests">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.TableWithCard"
                 DefaultPageTitle="Конкурс мероприятий">

<PageTitle>Конкурс мероприятий @ViewModel.Contest.Name</PageTitle>

<MudExpansionPanels Class="mb-3">
    <MudExpansionPanel>
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="@Color.Primary" Icon="@Icons.Material.Filled.Info" />
                <MudText Color="@Color.Primary" Class="ml-3">Конкурс мероприятий <strong>@ViewModel.Contest.Name</strong></MudText>
            </div>
        </TitleContent>
        <ChildContent>

            <MudText>Принимаются ли отзывы экспертов: <strong>@(ViewModel.Contest.ExpertCriterionsQuantity > 0 ? "Да" : "Нет")</strong></MudText>
            <MudText>Принимаются ли отзывы участников: <strong>@(ViewModel.Contest.ParticipantCriterionsQuantity > 0 ? "Да" : "Нет")</strong></MudText>

            @if (ViewModel.Contest.ParticipantCriterionsQuantity > 0)
            {
                <MudText>Принимаются ли отзывы от любых участников: <strong>@(!ViewModel.Contest.RegisteredGrading ? "Да" : "Нет")</strong></MudText>
                <MudText>Принимаются ли отзывы участников на свой отряд: <strong>@(ViewModel.Contest.FriendlyGrading ? "Да" : "Нет")</strong></MudText>
            }

            @if (ViewModel.Contest.ExpertCriterionsQuantity > 0)
            {
                <MudText>Количество критериев оценивания экспертами: <strong>@ViewModel.Contest.ExpertCriterionsQuantity</strong></MudText>
            }
            @if (ViewModel.Contest.ParticipantCriterionsQuantity > 0)
            {
                <MudText>Количество критериев оценивания участниками: <strong>@ViewModel.Contest.ParticipantCriterionsQuantity</strong></MudText>
            }

            <MudText>Контролируется ли посещаемость мероприятий: <strong>@(ViewModel.Contest.AttendanceControl ? "Да" : "Нет")</strong></MudText>
            <MudText>Общее число мероприятий в конкурсе: <strong>@ViewModel.Contest.EventsQuantity</strong></MudText>

            @if (ViewModel.Contest.ExpertCriterionsQuantity > 0)
            {
                <MudText>Число отзывов, оставленных экспертами: <strong>@ViewModel.Contest.ExpertFeedbacksQuantity</strong></MudText>
            }
            @if (ViewModel.Contest.ParticipantCriterionsQuantity > 0)
            {
                <MudText>Число отзывов, оставленных участниками: <strong>@ViewModel.Contest.ParticipantFeedbacksQuantity</strong></MudText>
            }

        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

<MudTable Items="@ViewModel.Events"
          Filter="@FilterRecords"
          Breakpoint="@Breakpoint.None"
          Hover="true"
          HorizontalScrollbar="true">

    <ToolBarContent>
        <MudText Typo="@Typo.h6">Мероприятия конкурса</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="@ViewModel.SearchFilter"
                      MaxLength="50"
                      Clearable="true"
                      Placeholder="Поиск"
                      Adornment="@Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" />
    </ToolBarContent>

    <HeaderContent>

        <MudTh>#</MudTh>
        <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectNameField">Название мероприятия</MudTableSortLabel></MudTh>
        <MudTh>Связанные отряды</MudTh>

        @if (ViewModel.Contest.ExpertCriterionsQuantity > 0)
        {
            <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectExpertFeedbacksField">Отзывы экспертов</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectExpertGradeField">Оценка экспертов</MudTableSortLabel></MudTh>
        }
        @if (ViewModel.Contest.ParticipantCriterionsQuantity > 0)
        {
            <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectParticipantFeedbacksField">Отзывы участников</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectParticipantGradeField">Оценка участников</MudTableSortLabel></MudTh>
        }

        <MudTh><MudTableSortLabel T="@EventsListModel.EventModel" SortBy="@SelectTotalGradeField">Общая оценка</MudTableSortLabel></MudTh>
        <MudTh>Действия</MudTh>
    </HeaderContent>

    <RowTemplate>

        <MudTd>@context.Number</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>
            @foreach (var item in @context.Brigades)
            {
                @item
                <br />
            }
        </MudTd>

        @if (ViewModel.Contest.ExpertCriterionsQuantity > 0)
        {
            <MudTd>@context.ExprertFeedbacksQuantity</MudTd>
            <MudTd>@context.ExpertGrade.ToString("0.0")</MudTd>
        }
        @if (ViewModel.Contest.ParticipantCriterionsQuantity > 0)
        {
            <MudTd>@context.ParticipantFeedbacksQuantity</MudTd>
            <MudTd>@context.ParticipantGrade.ToString("0.0")</MudTd>
        }

        <MudTd>@context.TotalGrade.ToString("0.0")</MudTd>
        <MudTd>

            @if (ViewModel.Contest.ExpertCriterionsQuantity > 0)
            {
                <MudButton Href="@NavigationHelper.Administration.ExpertFeedbacksList(context.Identifier)"
                           Variant="@Variant.Outlined"
                           Color="@Color.Primary"
                           StartIcon="@Icons.Material.Filled.Info"
                           Class="mr-3 mb-3">
                    Отзывы экспертов
                </MudButton>
            }
            @if (ViewModel.Contest.ParticipantCriterionsQuantity > 0)
            {
                <MudButton Href="@NavigationHelper.Administration.ParticipantFeedbacksList(context.Identifier)"
                           Variant="@Variant.Outlined"
                           Color="@Color.Primary"
                           StartIcon="@Icons.Material.Filled.Info"
                           Class="mr-3 mb-3">
                    Отзывы участников
                </MudButton>
            }

            <br/>

            @if (ViewModel.Contest.ExpertCriterionsQuantity > 0)
            {
                <MudButton Href="@NavigationHelper.Grading.ExpertFeedbackForm(context.Identifier)"
                           Variant="@Variant.Outlined"
                           Color="@Color.Secondary"
                           StartIcon="@Icons.Material.Filled.QrCode"
                           Class="mr-3 mb-3">
                    Форма эксперта
                </MudButton>
            }
            @if (ViewModel.Contest.ParticipantCriterionsQuantity > 0)
            {
                <MudButton Href="@NavigationHelper.Grading.ParticipantFeedbackForm(context.Identifier)"
                           Variant="@Variant.Outlined"
                           Color="@Color.Secondary"
                           StartIcon="@Icons.Material.Filled.QrCode"
                           Class="mr-3 mb-3">
                    Форма участника
                </MudButton>
            }

            <br />

            @if (ViewModel.Contest.AttendanceControl)
            {
                <MudButton Href="@NavigationHelper.Grading.FacilitatorAttendanceForm(context.Identifier)"
                           Variant="@Variant.Outlined"
                           Color="@Color.Tertiary"
                           StartIcon="@Icons.Material.Filled.QrCode"
                           Class="mr-3 mb-3">
                    Форма посещаемости
                </MudButton>
            }

        </MudTd>

    </RowTemplate>
</MudTable>

</ContentPageView>
</FeaturePageView>
