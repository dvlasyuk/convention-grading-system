@page "/administration/contests"

@using ConventionGradingSystem.Host.Components.Administration.Contests.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@attribute [Authorize(Roles = @AuthenticationConstants.AdministratorRole)]
@inherits BasePage<ContestsListModel>

<FeaturePageView Feature="@ApplicationFeature.Contests">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.Table"
                 DefaultPageTitle="Конкурсы мероприятий">

<PageTitle>Конкурсы мероприятий</PageTitle>

<MudTable Items="@ViewModel.Contests"
          Filter="@FilterRecords"
          Breakpoint="@Breakpoint.None"
          Hover="true">

    <ToolBarContent>
        <MudGrid Justify="@Justify.SpaceBetween">
            <MudItem><MudText Typo="@Typo.h6">Конкурсы мероприятий</MudText></MudItem>
            <MudItem xs="4">
                <MudTextField @bind-Value="@ViewModel.SearchFilter"
                              MaxLength="50"
                              Clearable="true"
                              Placeholder="Поиск"
                              Adornment="@Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
    </ToolBarContent>

    <HeaderContent>
        <MudTh />
        <MudTh><MudTableSortLabel T="@ContestsListModel.ContestModel" SortBy="@SelectNameField">Название конкурса</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@ContestsListModel.ContestModel" SortBy="@SelectEventsField">Количество мероприятий</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@ContestsListModel.ContestModel" SortBy="@SelectExpertField">Количество отзывов экспертов</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@ContestsListModel.ContestModel" SortBy="@SelectParticipantField">Количество отзывов участников</MudTableSortLabel></MudTh>
        <MudTh>Действия</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Number</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.EventsQuantity</MudTd>
        <MudTd>@context.ExpertFeedbaksQuantity</MudTd>
        <MudTd>@context.ParticiapntFeedbaksQuantity</MudTd>
        <MudTd>
            <MudMenu Color="@Color.Primary" Icon="@Icons.Material.Filled.Settings">
                <MudMenuItem OnClick="@(() => OpenContestCard(context))"
                             Icon="@Icons.Material.Filled.Info"
                             Label="Общая информация" />
                <MudMenuItem Href="@NavigationHelper.Administration.EventsList(context.Identifier)"
                             Icon="@Icons.Material.Filled.Link"
                             Label="Мероприятия конкурса" />
            </MudMenu>
        </MudTd>
    </RowTemplate>
</MudTable>

</ContentPageView>
</FeaturePageView>
