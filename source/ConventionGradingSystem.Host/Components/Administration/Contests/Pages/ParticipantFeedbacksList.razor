@page "/administration/events/{eventId}/participant-feedbacks"

@using ConventionGradingSystem.Host.Components.Administration.Contests.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inherits BasePage<ParticipantFeedbacksListModel>

<FeaturePageView Feature="@ApplicationFeature.Contests">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.TableWithCard"
                 DefaultPageTitle="Отзывы участников о мероприятии">

<PageTitle>Отзывы участников о мероприятии @ViewModel.Event.EventName</PageTitle>

@if (!ViewModel.Event.IsGraded)
{
    <MudAlert Severity="@Severity.Warning">
        Мероприятия конкурса <strong>@ViewModel.Event.ContestName</strong> не оцениваются участниками. Если
        ты вводил адрес страницы в адресную строку браузера вручную или вставлял скопированную ссылку, то
        проверь не ошибся ли ты при вводе или копировании. Если ты переходил по прямой ссылке, то проверь
        корректность этой ссылки или попроси сделать это того, кто её тебе предоставил. Если ты попал сюда
        с другой страницы системы, то это ошибка - обратись, пожалуйста, к разработчикам
    </MudAlert>
    return;
}

<MudExpansionPanels Class="mb-3">
    <MudExpansionPanel>
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="@Color.Primary" Icon="@Icons.Material.Filled.Info" />
                <MudText Color="@Color.Primary" Class="ml-3">Мероприятие <strong>@ViewModel.Event.EventName</strong></MudText>
            </div>
        </TitleContent>
        <ChildContent>
            <MudText>Название конкурса мероприятий: <strong>@ViewModel.Event.ContestName</strong></MudText>
            <MudText>Связанные с мероприятием отряды: <strong>@(string.Join(", ", ViewModel.Event.Brigades))</strong></MudText>
            <MudText>Число отзывов, оставленных участниками: <strong>@ViewModel.Event.FeedbacksQuantity</strong></MudText>

            @foreach (var criterion in ViewModel.Event.GradeCriterions)
            {
                <MudText>Оценка по критерию <em>@criterion.Name</em>: <strong>@criterion.TotalGrade.ToString("0.0")</strong></MudText>
            }

            <MudDivider Class="mt-3" />
            <MudButton Href="@($"/grading/events/{EventId}/participant-feedback")"
                       Variant="@Variant.Outlined"
                       Color="@Color.Secondary"
                       StartIcon="@Icons.Material.Filled.QrCode"
                       Class="mt-3">
                Форма участника
            </MudButton>

        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

<MudTable Items="@ViewModel.Feedbacks"
          Filter="@FilterRecords"
          Breakpoint="@Breakpoint.None"
          Hover="true">

    <ToolBarContent>
        <MudText Typo="@Typo.h6">Отзывы участников</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="@ViewModel.SearchFilter"
                      MaxLength="50"
                      Clearable="true"
                      Placeholder="Поиск"
                      Adornment="@Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" />
    </ToolBarContent>

    <HeaderContent>
        <MudTh>#</MudTh>
        <MudTh><MudTableSortLabel T="@ParticipantFeedbacksListModel.FeedbackModel" SortBy="@SelectNameField">Имя участника</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@ParticipantFeedbacksListModel.FeedbackModel" SortBy="@SelectBrigadeField">Отряд участника</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@ParticipantFeedbacksListModel.FeedbackModel" SortBy="@SelectTeamField">Команда участника</MudTableSortLabel></MudTh>

        @for (var number = 0; number < ViewModel.Event.GradeCriterions.Count; number++)
        {
            var index = number;
            <MudTh>
                <MudTableSortLabel T="@ParticipantFeedbacksListModel.FeedbackModel" SortBy="@(item => SelectGradeField(item, ViewModel.Event.GradeCriterions[index].Identifier))">
                    <MudTooltip Text="@ViewModel.Event.GradeCriterions[index].Name">
                        <div class="d-flex">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Size="@Size.Small" />
                            <MudText Class="ml-1">@(index + 1)</MudText>
                        </div>
                    </MudTooltip>
                </MudTableSortLabel>
            </MudTh>
        }

        <MudTh>Дополнительный комментарий</MudTh>
        <MudTh>Время получения</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Number</MudTd>
        <MudTd>@context.ParticipantName</MudTd>
        <MudTd>@context.ParticipantBrigade</MudTd>
        <MudTd>@context.ParticipantTeam</MudTd>

        @for (var number = 0; number < ViewModel.Event.GradeCriterions.Count; number++)
        {
            var index = number;
            <MudTd>@context.Grades[ViewModel.Event.GradeCriterions[index].Identifier]</MudTd>
        }

        <MudTd>@context.Note</MudTd>
        <MudTd>@context.ReceivedAt</MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudAlert Severity="@Severity.Info">
            О мероприятии <strong>@ViewModel.Event.EventName</strong> участниками не было оставлено ни одного отзыва
        </MudAlert>
    </NoRecordsContent>
</MudTable>

</ContentPageView>
</FeaturePageView>
