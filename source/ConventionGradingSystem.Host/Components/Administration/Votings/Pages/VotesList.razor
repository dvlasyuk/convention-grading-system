@page "/administration/candidates/{candidateId}/votes"

@using ConventionGradingSystem.Host.Components.Administration.Votings.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@attribute [Authorize(Roles = @AuthenticationConstants.AdministratorRole)]
@inherits BasePage<VotesListModel>

<FeaturePageView Feature="@ApplicationFeature.Votings">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.Table"
                 DefaultPageTitle="Голоса за кандидата">

<PageTitle>@ViewModel.Candidate.CandidateName - Голоса за кандидата</PageTitle>

<MudTable Items="@ViewModel.Votes"
          Filter="@FilterRecords"
          Breakpoint="@Breakpoint.None"
          Hover="true">

    <ToolBarContent>
        <MudGrid Justify="@Justify.SpaceBetween">
            <MudItem>
                <MudGrid Spacing="0" Class="align-center">
                    <MudItem><MudText Typo="@Typo.h6">Голоса за кандидата</MudText></MudItem>
                    <MudItem>
                        <MudIconButton OnClick="@OpenCandidateCard"
                                       Color="@Color.Primary"
                                       Icon="@Icons.Material.Filled.Info" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="5">
                <MudGrid Justify="@Justify.FlexEnd" Spacing="3" Class="align-center">
                    <MudItem>
                        <MudTooltip Text="Экспортировать данные в Excel">
                            <MudIconButton OnClick="ExportDataToExcel" Icon="@Icons.Custom.FileFormats.FileExcel" />
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="10">
                        <MudTextField @bind-Value="@ViewModel.SearchFilter"
                                      MaxLength="50"
                                      Clearable="true"
                                      Placeholder="Поиск"
                                      Adornment="@Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </ToolBarContent>

    <HeaderContent>
        <MudTh />
        <MudTh><MudTableSortLabel T="@VotesListModel.VoteModel" SortBy="@SelectNameField">Имя участника</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@VotesListModel.VoteModel" SortBy="@SelectBrigadeField">Отряд участника</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@VotesListModel.VoteModel" SortBy="@SelectTeamField">Команда участника</MudTableSortLabel></MudTh>
        <MudTh>Дополнительный комментарий</MudTh>
        <MudTh>Время получения</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Number</MudTd>
        <MudTd>@context.ParticipantName</MudTd>
        <MudTd>@context.ParticipantBrigade</MudTd>
        <MudTd>@context.ParticipantTeam</MudTd>
        <MudTd>@context.Note</MudTd>
        <MudTd>@context.ReceivedAt</MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudAlert Severity="@Severity.Info">
            За кандидата голосования <strong>@ViewModel.Candidate.CandidateName</strong> не было отдано ни одного голоса
        </MudAlert>
    </NoRecordsContent>
</MudTable>

</ContentPageView>
</FeaturePageView>
