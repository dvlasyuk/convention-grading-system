@page "/administration/votings/{votingId}/candidates"

@using ConventionGradingSystem.Host.Components.Administration.Votings.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@attribute [Authorize(Roles = @AuthenticationConstants.AdministratorRole)]
@inherits BasePage<CandidatesListModel>

<FeaturePageView Feature="@ApplicationFeature.Votings">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.Table"
                 DefaultPageTitle="Кандидаты голосования">

<PageTitle>@ViewModel.Voting.Name - Кандидаты голосования</PageTitle>

<MudTable Items="@ViewModel.Candidates"
          Filter="@FilterRecords"
          Breakpoint="@Breakpoint.None"
          Hover="true">

    <ToolBarContent>
        <MudGrid Justify="@Justify.SpaceBetween">
            <MudItem>
                <MudGrid Spacing="0" Class="align-center">
                    <MudItem><MudText Typo="@Typo.h6">Кандидаты голосования</MudText></MudItem>
                    <MudItem>
                        <MudIconButton OnClick="@OpenVotingCard"
                                       Color="@Color.Primary"
                                       Icon="@Icons.Material.Filled.Info" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="4">
                <MudTextField @bind-Value="@ViewModel.SearchFilter"
                              MaxLength="50"
                              Clearable="true"
                              Placeholder="Поиск"
                              Adornment="@Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
    </ToolBarContent>

    <HeaderContent>
        <MudTh />
        <MudTh><MudTableSortLabel T="@CandidatesListModel.CandidateModel" SortBy="@SelectNameField">Название/имя участника</MudTableSortLabel></MudTh>
        <MudTh>Связанные отряды</MudTh>
        <MudTh>Связанные команды</MudTh>
        <MudTh><MudTableSortLabel T="@CandidatesListModel.CandidateModel" SortBy="@SelectQuantityField">Количество голосов</MudTableSortLabel></MudTh>
        <MudTh>Действия</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Number</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>
            @foreach (var item in @context.Brigades)
            {
                @item
                <br />
            }
        </MudTd>
        <MudTd>
            @foreach (var item in @context.Teams)
            {
                @item
                <br />
            }
        </MudTd>
        <MudTd>@context.VotesQuantity</MudTd>
        <MudTd>
            <MudMenu Color="@Color.Primary" Icon="@Icons.Material.Filled.Settings">
                <MudMenuItem OnClick="@(() => OpenCandidateCard(context))"
                             Icon="@Icons.Material.Filled.Info"
                             Label="Общая информация" />
                <MudMenuItem Href="@NavigationHelper.Administration.VotesList(context.Identifier)"
                             Icon="@Icons.Material.Filled.Link"
                             Label="Список голосов" />
            </MudMenu>
        </MudTd>
    </RowTemplate>
</MudTable>

</ContentPageView>
</FeaturePageView>
