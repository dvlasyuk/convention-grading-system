@page "/administration/votings/{votingId}/candidates"

@using ConventionGradingSystem.Host.Components.Administration.Votings.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inherits BasePage<CandidatesListModel>

<FeaturePageView Feature="@ApplicationFeature.Votings">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.TableWithCard"
                 DefaultPageTitle="Зрительское голосование">

<PageTitle>Зрительское голосование @ViewModel.Voting.Name</PageTitle>

<MudExpansionPanels Class="mb-3">
    <MudExpansionPanel>
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="@Color.Primary" Icon="@Icons.Material.Filled.Info" />
                <MudText Color="@Color.Primary" Class="ml-3">Зрительское голосование <strong>@ViewModel.Voting.Name</strong></MudText>
            </div>
        </TitleContent>
        <ChildContent>
            <MudText>Допустимо ли голосование за свой отряд: <strong>@(ViewModel.Voting.BrigadeFriendlyVoting ? "Да" : "Нет")</strong></MudText>
            <MudText>Допустимо ли голосование за свою команду: <strong>@(ViewModel.Voting.TeamFriendlyVoting ? "Да" : "Нет")</strong></MudText>
            <MudText>Количество голосов от одного зрителя: <strong>@ViewModel.Voting.VotesQuantity</strong></MudText>
            <MudText>Общее число кандидатов в голосовании <strong>@ViewModel.Voting.CandidatesQuantity</strong></MudText>
            <MudText>Общее число голосов, отданных зрителями: <strong>@ViewModel.Voting.TotalVotesQuantity</strong></MudText>
            <MudDivider Class="mt-3" />
            <MudButton Href="@NavigationHelper.Grading.ParticipantVotingForm(VotingId!)"
                       Variant="@Variant.Outlined"
                       Color="@Color.Secondary"
                       StartIcon="@Icons.Material.Filled.QrCode"
                       Class="mt-3">
                Форма голосования
            </MudButton>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

<MudTable Items="@ViewModel.Candidates"
          Filter="@FilterRecords"
          Breakpoint="@Breakpoint.None"
          Hover="true">

    <ToolBarContent>
        <MudText Typo="@Typo.h6">Кандидаты голосования</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="@ViewModel.SearchFilter"
                      MaxLength="50"
                      Clearable="true"
                      Placeholder="Поиск"
                      Adornment="@Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" />
    </ToolBarContent>

    <HeaderContent>
        <MudTh>#</MudTh>
        <MudTh><MudTableSortLabel T="@CandidatesListModel.CandidateModel" SortBy="@SelectNameField">Название/имя участника</MudTableSortLabel></MudTh>
        <MudTh>Связанные отряды</MudTh>
        <MudTh>Связанные команды</MudTh>
        <MudTh><MudTableSortLabel T="@CandidatesListModel.CandidateModel" SortBy="@SelectQuantityField">Количество голосов</MudTableSortLabel></MudTh>
        <MudTh>Действия</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Number</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>
            @foreach (var item in @context.Brigades)
            {
                @item
                <br />
            }
        </MudTd>
        <MudTd>
            @foreach (var item in @context.Teams)
            {
                @item
                <br />
            }
        </MudTd>
        <MudTd>@context.VotesQuantity</MudTd>
        <MudTd>
            <MudButton Href="@NavigationHelper.Administration.VotesList(context.Identifier)"
                       Variant="@Variant.Outlined"
                       Color="@Color.Primary"
                       StartIcon="@Icons.Material.Filled.Info">
                Список голосов
            </MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

</ContentPageView>
</FeaturePageView>
