@page "/administration/votings/{votingId}/candidates"

@using ConventionGradingSystem.Host.Components.Administration.Votings.Models
@using ConventionGradingSystem.Host.Components.Shared.Layouts.Sections
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<LayoutView Layout="@typeof(VotingsLayout)">

    @if (_viewModel.Voting == null)
    {
        <PageTitle>Неизвестное зрительское голосование</PageTitle>
        <MudAlert Severity="@Severity.Warning">
            Зрительское голосование с идентификатором <em>@VotingId</em> <strong>не найдено</strong>. Если ты
            вводил адрес страницы в адресную строку браузера вручную или вставлял скопированную ссылку, то
            проверь не ошибся ли ты при вводе или копировании. Если ты переходил по прямой ссылке, то проверь
            корректность этой ссылки или попроси сделать это того, кто её тебе предоставил. Если ты попал сюда
            с другой страницы системы, то это ошибка - обратись, пожалуйста, к разработчикам
        </MudAlert>
        return;
    }

    <PageTitle>Зрительское голосование @_viewModel.Voting.Name</PageTitle>

    <MudExpansionPanels Class="mb-3">
        <MudExpansionPanel>
            <TitleContent>
                <div class="d-flex">
                    <MudIcon Color="@Color.Primary" Icon="@Icons.Material.Filled.Info" />
                    <MudText Color="@Color.Primary" Class="ml-3">Зрительское голосование <strong>@_viewModel.Voting.Name</strong></MudText>
                </div>
            </TitleContent>
            <ChildContent>
                <MudText>Допустимо ли голосование за свой отряд: <strong>@(_viewModel.Voting.BrigadeFriendlyVoting ? "Да" : "Нет")</strong></MudText>
                <MudText>Допустимо ли голосование за свою команду: <strong>@(_viewModel.Voting.TeamFriendlyVoting ? "Да" : "Нет")</strong></MudText>
                <MudText>Количество голосов от одного зрителя: <strong>@_viewModel.Voting.VotesQuantity</strong></MudText>
                <MudText>Общее число кандидатов в голосовании <strong>@_viewModel.Voting.CandidatesQuantity</strong></MudText>
                <MudText>Общее число голосов, отданных зрителями: <strong>@_viewModel.Voting.TotalVotesQuantity</strong></MudText>
                <MudDivider Class="mt-3" />
                <MudButton Href="@($"/grading/votings/{VotingId}/participant-voting")"
                           Variant="@Variant.Outlined"
                           Color="@Color.Secondary"
                           StartIcon="@Icons.Material.Filled.QrCode"
                           Class="mt-3">
                    Форма голосования
                </MudButton>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudTable Items="@_viewModel.Candidates"
              Filter="@FilterRecords"
              Breakpoint="@Breakpoint.None"
              Hover="true">

        <ToolBarContent>
            <MudText Typo="@Typo.h6">Кандидаты голосования</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="@_viewModel.SearchFilter"
                          MaxLength="50"
                          Clearable="true"
                          Placeholder="Поиск"
                          Adornment="@Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </ToolBarContent>

        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh><MudTableSortLabel T="@CandidatesListModel.CandidateModel" SortBy="@SelectNameField">Название/имя участника</MudTableSortLabel></MudTh>
            <MudTh>Связанные отряды</MudTh>
            <MudTh>Связанные команды</MudTh>
            <MudTh><MudTableSortLabel T="@CandidatesListModel.CandidateModel" SortBy="@SelectQuantityField">Количество голосов</MudTableSortLabel></MudTh>
            <MudTh>Действия</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.Number</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>
                @foreach (var item in @context.Brigades)
                {
                    @item
                    <br />
                }
            </MudTd>
            <MudTd>
                @foreach (var item in @context.Teams)
                {
                    @item
                    <br />
                }
            </MudTd>
            <MudTd>@context.VotesQuantity</MudTd>
            <MudTd>
                <MudButton Href="@context.VotesListLink"
                           Variant="@Variant.Outlined"
                           Color="@Color.Primary"
                           StartIcon="@Icons.Material.Filled.Info">
                    Список голосов
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>

</LayoutView>
