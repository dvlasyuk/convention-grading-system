@page "/administration/votings"

@using ConventionGradingSystem.Host.Components.Administration.Votings.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<FeaturePageView Feature="@ApplicationFeature.Votings">

<PageTitle>Зрительские голосования</PageTitle>

<MudTable Items="@_viewModel.Votings"
          Filter="@FilterRecords"
          Breakpoint="@Breakpoint.None"
          Hover="true">

    <ToolBarContent>
        <MudText Typo="@Typo.h6">Зрительские голосования</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="@_viewModel.SearchFilter"
                      MaxLength="50"
                      Clearable="true"
                      Placeholder="Поиск"
                      Adornment="@Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" />
    </ToolBarContent>

    <HeaderContent>
        <MudTh>#</MudTh>
        <MudTh><MudTableSortLabel T="@VotingsListModel.VotingModel" SortBy="@SelectNameField">Название голосования</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@VotingsListModel.VotingModel" SortBy="@SelectCandidatesField">Количество кандидатов</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@VotingsListModel.VotingModel" SortBy="@SelectVotesField">Общее количество голосов</MudTableSortLabel></MudTh>
        <MudTh>Действия</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Number</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.CandidatesQuantity</MudTd>
        <MudTd>@context.TotalVotesQuantity</MudTd>
        <MudTd>
            <MudButton Href="@context.CandidatesListLink"
                       Variant="@Variant.Outlined"
                       Color="@Color.Primary"
                       StartIcon="@Icons.Material.Filled.Info">
                Детали
            </MudButton>
            <MudButton Href="@context.ParticipantVotingFormLink"
                       Variant="@Variant.Outlined"
                       Color="@Color.Secondary"
                       StartIcon="@Icons.Material.Filled.QrCode"
                       Class="ml-3">
                Форма голосования
            </MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

</FeaturePageView>
