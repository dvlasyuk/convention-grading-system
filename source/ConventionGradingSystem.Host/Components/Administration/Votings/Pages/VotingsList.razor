@page "/administration/votings"

@using ConventionGradingSystem.Host.Components.Administration.Votings.Models
@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Components.Shared.Pages
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@attribute [Authorize(Roles = @AuthenticationConstants.AdministratorRole)]
@inherits BasePage<VotingsListModel>

<FeaturePageView Feature="@ApplicationFeature.Votings">
<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.Table"
                 DefaultPageTitle="Зрительские голосования">

<PageTitle>Зрительские голосования</PageTitle>

<MudTable Items="@ViewModel.Votings"
          Filter="@FilterRecords"
          Breakpoint="@Breakpoint.None"
          Hover="true">

    <ToolBarContent>
        <MudGrid Justify="@Justify.SpaceBetween">
            <MudItem><MudText Typo="@Typo.h6">Зрительские голосования</MudText></MudItem>
            <MudItem xs="4">
                <MudTextField @bind-Value="@ViewModel.SearchFilter"
                              MaxLength="50"
                              Clearable="true"
                              Placeholder="Поиск"
                              Adornment="@Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
    </ToolBarContent>

    <HeaderContent>
        <MudTh />
        <MudTh><MudTableSortLabel T="@VotingsListModel.VotingModel" SortBy="@SelectNameField">Название голосования</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@VotingsListModel.VotingModel" SortBy="@SelectCandidatesField">Количество кандидатов</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="@VotingsListModel.VotingModel" SortBy="@SelectVotesField">Общее количество голосов</MudTableSortLabel></MudTh>
        <MudTh>Действия</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Number</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.CandidatesQuantity</MudTd>
        <MudTd>@context.TotalVotesQuantity</MudTd>
        <MudTd>
            <MudMenu Color="@Color.Primary" Icon="@Icons.Material.Filled.Settings">
                <MudMenuItem OnClick="@(() => OpenVotingCard(context))"
                             Icon="@Icons.Material.Filled.Info"
                             Label="Общая информация" />
                <MudMenuItem Href="@NavigationHelper.Administration.CandidatesList(context.Identifier)"
                             Icon="@Icons.Material.Filled.Link"
                             Label="Кандидаты голосования" />
                <MudDivider />
                <MudMenuItem Href="@NavigationHelper.Grading.ParticipantVotingForm(context.Identifier)"
                             Icon="@Icons.Material.Filled.QrCode"
                             Label="Форма голосования" />
            </MudMenu>
        </MudTd>
    </RowTemplate>
</MudTable>

</ContentPageView>
</FeaturePageView>
