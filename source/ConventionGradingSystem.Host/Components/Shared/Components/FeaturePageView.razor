@using ConventionGradingSystem.Host.Components.Shared.Models
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inherits BaseFeatureView

@if (IsFeatureEnabled)
{
    @ChildContent
}
else
{
    switch (Feature)
    {
        case ApplicationFeature.Contests:
            <PageTitle>Конкурсы мероприятий</PageTitle>
            <MudAlert Severity="@Severity.Warning">
                В рамках слёта не проводятся конкурсы мероприятий. Если ты вводил адрес страницы в адресную строку
                браузера вручную или вставлял скопированную ссылку, то проверь не ошибся ли ты при вводе или
                копировании. Если ты переходил по прямой ссылке, то проверь корректность этой ссылки или попроси
                сделать это того, кто её тебе предоставил. Если ты попал сюда с другой страницы системы, то это
                ошибка - обратись, пожалуйста, к разработчикам
            </MudAlert>
            break;

        case ApplicationFeature.Votings:
            <PageTitle>Зрительские голосования</PageTitle>
            <MudAlert Severity="@Severity.Warning">
                В рамках слёта не проводятся зрительские голосования. Если ты вводил адрес страницы в адресную
                строку браузера вручную или вставлял скопированную ссылку, то проверь не ошибся ли ты при вводе или
                копировании. Если ты переходил по прямой ссылке, то проверь корректность этой ссылки или попроси
                сделать это того, кто её тебе предоставил. Если ты попал сюда с другой страницы системы, то это
                ошибка - обратись, пожалуйста, к разработчикам
            </MudAlert>
            break;

        case ApplicationFeature.Teams:
            <PageTitle>Команды участников</PageTitle>
            <MudAlert Severity="@Severity.Warning">
                В рамках слёта не формируются команды участников. Если ты вводил адрес страницы в адресную строку
                браузера вручную или вставлял скопированную ссылку, то проверь не ошибся ли ты при вводе или
                копировании. Если ты переходил по прямой ссылке, то проверь корректность этой ссылки или попроси
                сделать это того, кто её тебе предоставил. Если ты попал сюда с другой страницы системы, то это
                ошибка - обратись, пожалуйста, к разработчикам
            </MudAlert>
            break;
    }
}
