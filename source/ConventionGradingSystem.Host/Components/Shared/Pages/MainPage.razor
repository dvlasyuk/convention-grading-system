@page "/"

@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inherits BasePage<MainPageModel>

<ContentPageView LoadingStatus="@LoadingStatus"
                 LoadingError="@LoadingError"
                 ContentType="@ContentType.Default"
                 DefaultPageTitle="Главная страница">

<PageTitle>Главная страница</PageTitle>

<MudText Typo="@Typo.h6">Приветствуем тебя, важный пирожочек!</MudText>
<MudText Class="mt-3">
    Добро пожаловать в систему оценивания cлёта <strong>@ViewModel.ConventionName</strong>. Для получения
    интересующей тебя информации ты можешь воспользоваться главным меню, которое доступно по кнопке
    в левом верхнем углу
</MudText>

<MudList T="@string" Dense="true" Class="mt-3">

    <FeatureView Feature="@ApplicationFeature.Contests">
        <MudListItem Href="@NavigationHelper.Administration.ContestsList()" Icon="@Icons.Material.Filled.Star">
            Раздел <MudLink Href="@NavigationHelper.Administration.ContestsList()">Конкурсы мероприятий</MudLink>
            содержит всю необходимую информацию о конкурсах, в рамках которых проводимые мероприятия оцениваются
            экспертами и/или участниками слёта по настроенным критериям
        </MudListItem>
    </FeatureView>

    <FeatureView Feature="@ApplicationFeature.Votings">
        <MudListItem Href="@NavigationHelper.Administration.VotingsList()" Icon="@Icons.Material.Filled.HowToVote">
            В разделе <MudLink Href="@NavigationHelper.Administration.VotingsList()">Зрительские голосования</MudLink>
            ты найдёшь всю требуемую информацию о конкурсах зрительских симпатий, в рамках которых участники слёта
            голосуют за понравившихся им участников конкурсов
        </MudListItem>
    </FeatureView>

    <FeatureView Feature="@ApplicationFeature.Teams">
        <MudListItem Href="@NavigationHelper.Administration.TeamsList()" Icon="@Icons.Material.Filled.Groups">
            В разделе <MudLink Href="@NavigationHelper.Administration.TeamsList()">Команды участников</MudLink> собрана
            информация о регистрации и посещении участниками слёта мероприятий, которую можно использовать в рамках
            системы мотивации
        </MudListItem>
    </FeatureView>

</MudList>

</ContentPageView>
