@inherits LayoutComponentBase

@using ConventionGradingSystem.Host.Components.Shared.Components
@using ConventionGradingSystem.Host.Components.Shared.Models
@using ConventionGradingSystem.Host.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<AuthorizeView Roles="@AuthenticationConstants.AdministratorRole">
    <Authorized>

        <MudThemeProvider IsDarkMode="true" />
        <MudPopoverProvider />

        <MudLayout>

            <MudAppBar>
                <MudIconButton title="Главное меню"
                               Icon="@Icons.Material.Filled.Menu"
                               Variant="@Variant.Outlined"
                               Color="@Color.Primary"
                               Edge="@Edge.Start"
                               OnClick="@ToogleDrawer" />

                <MudImage Src="favicon-32.png" Class="ml-5" />
                <MudText Typo="@Typo.h6" Class="ml-2">Система оценивания слёта <strong>@_viewModel!.ConventionName</strong></MudText>

                <MudSpacer />
                <MudIconButton title="Выйти из системы"
                               Icon="@Icons.Material.Filled.Logout"
                               Variant="@Variant.Outlined"
                               OnClick="@OnSignOutFromSystem" />
            </MudAppBar>

            <MudDrawer ClipMode="@DrawerClipMode.Docked" Width="300px" @bind-Open="@_viewModel!.IsDrawerOpen">
                <MudDrawerHeader>
                    <MudText Typo="@Typo.subtitle1">Главное меню</MudText>
                </MudDrawerHeader>
                <MudNavMenu Bordered="true">

                    <MudNavLink Href="@NavigationHelper.MainPage()" Match="@NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                        Главная страница
                    </MudNavLink>

                    <FeatureView Feature="@ApplicationFeature.Contests">
                        <MudNavLink Href="@NavigationHelper.Administration.ContestsList()" Match="@NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Star">
                            Конкурсы мероприятий
                        </MudNavLink>
                    </FeatureView>

                    <FeatureView Feature="@ApplicationFeature.Votings">
                        <MudNavLink Href="@NavigationHelper.Administration.VotingsList()" Match="@NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HowToVote">
                            Зрительские голосования
                        </MudNavLink>
                    </FeatureView>

                    <FeatureView Feature="@ApplicationFeature.Teams">
                        <MudNavLink Href="@NavigationHelper.Administration.TeamsList()" Match="@NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups">
                            Команды участников
                        </MudNavLink>
                    </FeatureView>

                </MudNavMenu>
            </MudDrawer>

            <MudMainContent>
                <MudContainer Fixed="true" Class="pt-3">
                    @Body
                </MudContainer>
            </MudMainContent>

        </MudLayout>
    </Authorized>

    <NotAuthorized>
        <PageTitle>Вход в систему</PageTitle>
        <LayoutView Layout="@typeof(BaseLayout)">
            <SignInForm />
        </LayoutView>
    </NotAuthorized>

</AuthorizeView>
