@inherits LayoutComponentBase

@using ConventionGradingSystem.Host.Components.Shared.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<AuthorizeView Roles="Administrator">
    <Authorized>

        <MudThemeProvider IsDarkMode="true" />
        <MudPopoverProvider />

        <MudLayout>

            <MudAppBar>
                <MudIconButton title="Главное меню"
                               Icon="@Icons.Material.Filled.Menu"
                               Variant="@Variant.Outlined"
                               Color="@Color.Primary"
                               Edge="@Edge.Start"
                               OnClick="@ToogleDrawer" />

                <MudImage Src="favicon-32.png" Class="ml-5" />
                <MudText Typo="@Typo.h6" Class="ml-2">Система оценивания слёта <strong>@_viewModel.ConventionName</strong></MudText>

                <MudSpacer />
                <MudIconButton title="Выйти из системы"
                               Icon="@Icons.Material.Filled.Logout"
                               Variant="@Variant.Outlined"
                               OnClick="@OnSignOutFromSystem" />
            </MudAppBar>

            <MudDrawer ClipMode="@DrawerClipMode.Docked" Width="300px" @bind-Open="@_viewModel.IsDrawerOpen">
                <MudDrawerHeader>
                    <MudText Typo="@Typo.subtitle1">Главное меню</MudText>
                </MudDrawerHeader>
                <MudNavMenu Bordered="true">

                    <MudNavLink Href="/" Match="@NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Главная страница</MudNavLink>

                    @if (_viewModel.ContestsSectionAvailable)
                    {
                        <MudNavLink Href="/administration/contests" Match="@NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Star">Конкурсы мероприятий</MudNavLink>
                    }
                    @if (_viewModel.VotingsSectionAvailable)
                    {
                        <MudNavLink Href="/administration/votings" Match="@NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HowToVote">Зрительские голосования</MudNavLink>
                    }
                    @if (_viewModel.TeamsSectionAvailable)
                    {
                        <MudNavLink Href="/administration/teams" Match="@NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups">Команды участников</MudNavLink>
                    }

                </MudNavMenu>
            </MudDrawer>

            <MudMainContent>
                <MudContainer Fixed="true" Class="pt-3">
                    @Body
                </MudContainer>
            </MudMainContent>

        </MudLayout>
    </Authorized>

    <NotAuthorized>
        <PageTitle>Вход в систему</PageTitle>
        <LayoutView Layout="@typeof(BaseLayout)">
            <SignInForm />
        </LayoutView>
    </NotAuthorized>

</AuthorizeView>
